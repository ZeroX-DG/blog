---
import Layout from '../components/Layout.astro';
import PostListItem from '../components/PostListItem.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

// Sort posts by date descending
const sortedPosts = posts.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
  <div class="index-page">
    <div class="introduction">
      <h1 class="name"><a href={`${base}/`}>Viet-Hung Nguyen</a></h1>
      <p>
        <a href="https://github.com/ZeroX-DG" target="_blank">GitHub</a> •
        <a href="https://twitter.com/itsviethung" target="_blank">Twitter</a> •
        <a href="https://www.linkedin.com/in/v-hung/" target="_blank">LinkedIn</a>
      </p>
    </div>
    <div class="blog-post-list">
      <div class="post-filters">
        <span class="filter-item active" data-filter="all">All</span>
        <span class="filter-separator">/</span>
        <span class="filter-item" data-filter="technical">Technical</span>
        <span class="filter-separator">/</span>
        <span class="filter-item" data-filter="random">Random</span>
      </div>
      <div class="posts-container">
        {sortedPosts.map(post => <PostListItem post={post} />)}
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterItems = document.querySelectorAll<HTMLElement>('.filter-item');
    const posts = document.querySelectorAll<HTMLElement>('.blog-post-item');

    filterItems.forEach(item => {
      item.addEventListener('click', () => {
        const filter = item.dataset.filter;
        if (!filter) return;

        // Update active item
        filterItems.forEach(i => i.classList.remove('active'));
        item.classList.add('active');

        // Filter posts
        posts.forEach(post => {
          const tags = post.dataset.tags ? post.dataset.tags.split(',') : [];

          if (filter === 'all') {
            post.style.display = 'flex';
          } else if (tags.includes(filter)) {
            post.style.display = 'flex';
          } else {
            post.style.display = 'none';
          }
        });
      });
    });
  });
</script>
